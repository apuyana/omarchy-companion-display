#!/usr/bin/env python3
"""Lyrics lookup for the Omarchy companion display.

Usage: companion-lyrics ARTIST TITLE [ALBUM] [DURATION_SECONDS]

Looks the track up on LRCLIB (https://lrclib.net), a free lyrics database
that needs no account, and prints one JSON object on stdout:

    {"track": [ARTIST, TITLE], "found": true, "instrumental": false,
     "synced": [{"t": 12.3, "text": "..."}, ...], "plain": ["...", ...]}

"synced" is empty when only unsynced lyrics exist. Results, including misses,
are cached under ~/.cache/omarchy-companion-display/lyrics so each track is
fetched once. Only depends on the Python standard library.
"""

import hashlib
import json
import os
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

API = "https://lrclib.net/api"
USER_AGENT = "omarchy-companion-display (https://github.com/apuyana/omarchy-companion-display)"
CACHE_DIR = os.path.join(
    os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")),
    "omarchy-companion-display",
    "lyrics",
)
# Retry tracks that were not found after a week; the database keeps growing.
MISS_TTL = 7 * 24 * 3600
TIMESTAMP = re.compile(r"\[(\d+):(\d+(?:\.\d+)?)\]")
VERSION_SUFFIX = re.compile(
    r"\s*(?:-\s*|[(\[])(?:live|remaster|remastered|\d{4} remaster|mono|stereo|single version"
    r"|radio edit|acoustic|demo|bonus track|deluxe)\b.*$",
    re.IGNORECASE,
)


def request(path, params):
    url = API + path + "?" + urllib.parse.urlencode(params)
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            return json.load(resp)
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return None
        raise


def parse_synced(lrc):
    lines = []
    for raw in (lrc or "").splitlines():
        stamps = TIMESTAMP.findall(raw)
        text = TIMESTAMP.sub("", raw).strip()
        for minutes, seconds in stamps:
            lines.append({"t": int(minutes) * 60 + float(seconds), "text": text})
    return sorted(lines, key=lambda line: line["t"])


def base_title(title):
    """Title without a version suffix: "Song - Live", "Song - Remastered 2011",
    "Song (Live at ...)". Returns (title, is_live)."""
    m = VERSION_SUFFIX.search(title)
    if not m:
        return title, False
    return title[:m.start()].strip(), "live" in m.group(0).lower()


def search(artist, title, duration):
    # The exact match needs album and duration to agree; fall back to a
    # search and keep the closest duration.
    results = request("/search", {"artist_name": artist, "track_name": title}) or []
    if duration:
        results.sort(key=lambda r: abs((r.get("duration") or 0) - duration))
    synced = [r for r in results if r.get("syncedLyrics")]
    return (synced or results or [None])[0]


def lookup(artist, title, album, duration):
    params = {"artist_name": artist, "track_name": title}
    if album:
        params["album_name"] = album
    if duration:
        params["duration"] = round(duration)
    hit = request("/get", params) or search(artist, title, duration)
    live = False
    if not hit:
        # Live and remastered tracks are usually stored under the plain title.
        plain_title, live = base_title(title)
        if plain_title and plain_title != title:
            hit = search(artist, plain_title, 0 if live else duration)
    if not hit:
        return {"found": False}
    return {
        "found": True,
        "instrumental": bool(hit.get("instrumental")),
        # Studio timings drift on a live recording, so show those unsynced.
        "synced": [] if live else parse_synced(hit.get("syncedLyrics")),
        "plain": [line.strip() for line in (hit.get("plainLyrics") or "").splitlines()],
    }


def emit(artist, title, result):
    # Echo the track so the panel can drop answers for a song that already ended.
    print(json.dumps(dict(result, track=[artist, title])))


def main():
    if len(sys.argv) < 3:
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(2)
    artist, title = sys.argv[1], sys.argv[2]
    album = sys.argv[3] if len(sys.argv) > 3 else ""
    try:
        duration = float(sys.argv[4]) if len(sys.argv) > 4 else 0
    except ValueError:
        duration = 0

    key = hashlib.sha1("\0".join([artist, title, album]).lower().encode()).hexdigest()
    path = os.path.join(CACHE_DIR, key + ".json")
    try:
        with open(path) as f:
            cached = json.load(f)
        if cached.get("found") or time.time() - os.path.getmtime(path) < MISS_TTL:
            emit(artist, title, cached)
            return
    except (OSError, ValueError):
        pass

    try:
        result = lookup(artist, title, album, duration)
    except (urllib.error.URLError, OSError, ValueError):
        # Offline or the service is down: report it without caching.
        emit(artist, title, {"found": False, "error": True})
        return

    os.makedirs(CACHE_DIR, exist_ok=True)
    with open(path, "w") as f:
        json.dump(result, f)
    emit(artist, title, result)


if __name__ == "__main__":
    main()
