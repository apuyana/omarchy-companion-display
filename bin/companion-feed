#!/usr/bin/env python3
"""Data feed for the Omarchy companion display.

Collects phone notifications from KDE Connect, mail notifications posted on
the desktop, Claude Code session status and, optionally, task status from a
Paperclip instance, and prints the combined state as one JSON object per line on
stdout every time it changes. Reads simple commands from stdin:

    seen              mark every mail as seen (resets the "new" count)
    refresh           re-read everything now
    dismiss KEY...    dismiss phone notifications ("<device>/<id>") or
                      desktop mails ("mail:<id>")

Only depends on the Python standard library and PyGObject (Gio), which ship
with Omarchy.
"""

import json
import os
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

KDECONNECT = "org.kde.kdeconnect"
NOTIF_IFACE = "org.kde.kdeconnect.device.notifications"
NOTIF_ITEM_IFACE = NOTIF_IFACE + ".notification"
DEVICE_IFACE = "org.kde.kdeconnect.device"

CONFIG_PATH = os.path.expanduser("~/.config/omarchy/companion-display.json")
STATE_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
    "omarchy-companion-display",
)
MAIL_STATE = os.path.join(STATE_DIR, "mail.json")
CLAUDE_SESSIONS = os.path.expanduser("~/.claude/sessions")

DEFAULTS = {
    "chatApps": ["WhatsApp", "WhatsApp Business", "Telegram", "Signal", "Messages"],
    "mailApps": None,  # None: the system default mail client
    "phoneMailApps": ["Outlook", "Gmail", "BlueMail"],
    "ignoreApps": [],
    "mailHistory": 30,
    "paperclip": {},
    "demo": False,
}


def load_config():
    cfg = dict(DEFAULTS)
    try:
        with open(CONFIG_PATH) as f:
            user = json.load(f)
        for key in DEFAULTS:
            if key in user:
                cfg[key] = user[key]
    except (OSError, ValueError):
        pass
    if cfg["mailApps"] is None:
        cfg["mailApps"] = default_mail_app_names()
    return cfg


def default_mail_app_names():
    """Names the default mailto handler may use as notification app name."""
    try:
        desktop = subprocess.run(
            ["xdg-mime", "query", "default", "x-scheme-handler/mailto"],
            capture_output=True, text=True, timeout=5,
        ).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return []
    if not desktop:
        return []
    names = {desktop[:-len(".desktop")] if desktop.endswith(".desktop") else desktop}
    data_dirs = [os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share"))]
    data_dirs += os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
    for base in data_dirs:
        path = os.path.join(base, "applications", desktop)
        if not os.path.isfile(path):
            continue
        with open(path, errors="replace") as f:
            for line in f:
                key, _, value = line.strip().partition("=")
                if key in ("Name", "StartupWMClass") and value:
                    names.add(value)
                    names.add(value.split()[0])
        break
    return sorted(names)


def lower_set(items):
    return {str(x).lower() for x in items}


class Feed:
    def __init__(self):
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.config = load_config()
        # First time we saw each phone notification, keyed by device/id, so
        # chats and mail can be sorted and timestamped.
        self.first_seen = {}
        self.phone = {"name": "", "reachable": False}
        self.phone_items = []
        self.desktop_mail = []
        self.seen_at = 0
        self.paperclip = None
        self.claude_sessions = []
        self.last_output = None
        self.refresh_pending = False
        self.load_mail_state()

    # ----------------------------------------------------------- persistence

    def load_mail_state(self):
        try:
            with open(MAIL_STATE) as f:
                data = json.load(f)
            self.desktop_mail = data.get("mail", [])
            self.seen_at = data.get("seenAt", 0)
            self.first_seen = data.get("phoneFirstSeen", {})
        except (OSError, ValueError):
            pass

    def save_mail_state(self):
        os.makedirs(STATE_DIR, exist_ok=True)
        tmp = MAIL_STATE + ".tmp"
        with open(tmp, "w") as f:
            json.dump({"seenAt": self.seen_at, "mail": self.desktop_mail,
                       "phoneFirstSeen": self.first_seen}, f)
        os.replace(tmp, MAIL_STATE)

    # ------------------------------------------------------------ D-Bus utils

    def call(self, path, iface, method, args=None, reply="(v)"):
        result = self.bus.call_sync(
            KDECONNECT, path, iface, method, args,
            GLib.VariantType.new(reply), Gio.DBusCallFlags.NONE, 3000, None,
        )
        return result.unpack()

    def prop(self, path, iface, name):
        return self.call(
            path, "org.freedesktop.DBus.Properties", "Get",
            GLib.Variant("(ss)", (iface, name)),
        )[0]

    def all_props(self, path, iface):
        return self.call(
            path, "org.freedesktop.DBus.Properties", "GetAll",
            GLib.Variant("(s)", (iface,)), "(a{sv})",
        )[0]

    # --------------------------------------------------------- KDE Connect

    def read_phone(self):
        items = []
        phone = {"name": "", "reachable": False}
        try:
            devices = self.call(
                "/modules/kdeconnect", "org.kde.kdeconnect.daemon", "devices",
                GLib.Variant("(bb)", (False, True)), "(as)",
            )[0]
        except GLib.Error:
            devices = []

        now = time.time()
        before = dict(self.first_seen)
        live = set()
        for dev in devices:
            base = "/modules/kdeconnect/devices/" + dev
            try:
                reachable = bool(self.prop(base, DEVICE_IFACE, "isReachable"))
                name = str(self.prop(base, DEVICE_IFACE, "name"))
            except GLib.Error:
                continue
            # Show the first reachable device, else the first paired one.
            if not phone["name"] or (reachable and not phone["reachable"]):
                phone = {"name": name, "reachable": reachable}
            try:
                ids = self.call(base + "/notifications", NOTIF_IFACE,
                                "activeNotifications", None, "(as)")[0]
            except GLib.Error:
                continue
            for nid in ids:
                try:
                    p = self.all_props(base + "/notifications/" + nid, NOTIF_ITEM_IFACE)
                except GLib.Error:
                    continue
                key = dev + "/" + nid
                live.add(key)
                ts = self.first_seen.setdefault(key, now)
                items.append({
                    "key": key,
                    "app": str(p.get("appName", "")),
                    "title": str(p.get("title", "")),
                    "text": str(p.get("text", "")),
                    "group": str(p.get("groupName", "")),
                    "isGroup": bool(p.get("isGroupConversation", False)),
                    "dismissable": bool(p.get("dismissable", True)),
                    "ts": ts,
                })
        self.first_seen = {k: v for k, v in self.first_seen.items() if k in live}
        if self.first_seen != before:
            self.save_mail_state()
        self.phone = phone
        self.phone_items = items

    # --------------------------------------------------- desktop mail notify

    def on_desktop_notify(self, app, summary, body):
        cfg = self.config
        if app.lower() not in lower_set(cfg["mailApps"]):
            return
        self.desktop_mail.insert(0, {
            "app": app, "summary": summary, "body": body,
            "ts": time.time(), "source": "desktop",
        })
        del self.desktop_mail[int(cfg["mailHistory"]):]
        self.save_mail_state()
        self.emit()

    def watch_desktop_notifications(self):
        match = ("type='method_call',interface='org.freedesktop.Notifications',"
                 "member='Notify'")
        proc = subprocess.Popen(
            ["busctl", "--user", "monitor", "--json=short", "--match", match],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, bufsize=1,
        )
        for line in proc.stdout:
            try:
                msg = json.loads(line)
                data = msg["payload"]["data"]
                app, summary, body = str(data[0]), str(data[3]), str(data[4])
            except (ValueError, KeyError, IndexError, TypeError):
                continue
            GLib.idle_add(self.on_desktop_notify, app, summary, body)

    # ------------------------------------------------------------ paperclip

    def paperclip_get(self, base, token, path, params=None):
        url = base.rstrip("/") + "/api" + path
        if params:
            url += "?" + urllib.parse.urlencode(params)
        req = urllib.request.Request(url, headers={
            "Authorization": "Bearer " + token, "Accept": "application/json",
        })
        with urllib.request.urlopen(req, timeout=15) as resp:
            return json.load(resp)

    @staticmethod
    def issue_url(base, identifier):
        # Issues live at /<company prefix>/issues/<identifier>, e.g. /ANU/issues/ANU-372.
        prefix = identifier.split("-")[0]
        if not prefix:
            return ""
        return "%s/%s/issues/%s" % (base.rstrip("/"), prefix, urllib.parse.quote(identifier))

    def read_paperclip(self, cfg):
        base, company = cfg.get("url"), cfg.get("companyId")
        token_file = os.path.expanduser(cfg.get(
            "tokenFile", "~/.config/omarchy/companion-display-paperclip.token"))
        try:
            with open(token_file) as f:
                token = f.read().strip()
        except OSError:
            return {"ok": False, "error": "Missing API key (" + token_file + ")"}
        if not token:
            return {"ok": False, "error": "The API key file is empty"}
        try:
            dash = self.paperclip_get(base, token, "/companies/%s/dashboard" % company)
            issues = self.paperclip_get(base, token, "/companies/%s/issues" % company,
                                        {"status": "blocked,in_review,in_progress"})
            agents = self.paperclip_get(base, token, "/companies/%s/agents" % company)
        except urllib.error.HTTPError as e:
            msg = {401: "Invalid or expired API key", 403: "No access to this company"}
            return {"ok": False, "error": msg.get(e.code, "HTTP %d" % e.code)}
        except (urllib.error.URLError, OSError, ValueError) as e:
            return {"ok": False, "error": "Cannot reach Paperclip: " + str(getattr(e, "reason", e))}

        if isinstance(issues, dict):
            issues = issues.get("issues") or issues.get("items") or []
        if isinstance(agents, dict):
            agents = agents.get("agents") or agents.get("items") or []
        names = {a.get("id"): a.get("name", "") for a in agents}
        order = {"blocked": 0, "in_review": 1, "in_progress": 2}
        counts = {"blocked": 0, "in_review": 0, "in_progress": 0}
        rows = []
        for i in issues:
            status = i.get("status")
            if status not in counts:
                continue
            counts[status] += 1
            rows.append({
                "identifier": i.get("identifier", ""),
                "title": i.get("title", ""),
                "status": status,
                "assignee": names.get(i.get("assigneeAgentId"), "Board" if i.get("assigneeUserId") else ""),
                "updatedAt": i.get("updatedAt", ""),
                "url": self.issue_url(base, i.get("identifier", "")),
            })
        rows.sort(key=lambda r: r["updatedAt"], reverse=True)
        rows.sort(key=lambda r: order[r["status"]])
        statuses = [a.get("status") for a in agents]
        approvals = dash.get("pendingApprovals", 0)
        if isinstance(approvals, list):
            approvals = len(approvals)
        return {
            "ok": True,
            "blocked": counts["blocked"],
            "inReview": counts["in_review"],
            "inProgress": counts["in_progress"],
            "approvals": approvals,
            "agentsBusy": sum(1 for s in statuses if s in ("running", "active")),
            "agentsIdle": sum(1 for s in statuses if s == "idle"),
            "agentsPaused": sum(1 for s in statuses if s == "paused"),
            "agentsError": sum(1 for s in statuses if s == "error"),
            "issues": rows,
            "updated": time.time(),
        }

    def set_paperclip(self, data):
        self.paperclip = data
        self.emit()
        return False

    def poll_paperclip(self):
        while True:
            cfg = self.config.get("paperclip") or {}
            if cfg.get("url") and cfg.get("companyId"):
                GLib.idle_add(self.set_paperclip, self.read_paperclip(cfg))
            elif self.paperclip is not None:
                GLib.idle_add(self.set_paperclip, None)
            time.sleep(max(30, int(cfg.get("interval", 60))))

    # --------------------------------------------------------------- claude

    @staticmethod
    def process_start(pid):
        try:
            with open("/proc/%d/stat" % pid) as f:
                # Field 22 (start time), counted after the parenthesised name.
                return f.read().rsplit(")", 1)[1].split()[19]
        except (OSError, IndexError):
            return None

    def read_claude(self):
        sessions = []
        try:
            names = os.listdir(CLAUDE_SESSIONS)
        except OSError:
            names = []
        for name in names:
            if not name.endswith(".json"):
                continue
            try:
                with open(os.path.join(CLAUDE_SESSIONS, name)) as f:
                    data = json.load(f)
            except (OSError, ValueError):
                continue
            pid = data.get("pid")
            # Session files outlive crashed processes and pids get reused, so
            # only trust a file whose process is alive with the same start time.
            if not isinstance(pid, int):
                continue
            start = self.process_start(pid)
            if start is None or (data.get("procStart") and str(data["procStart"]) != start):
                continue
            cwd = data.get("cwd", "")
            sessions.append({
                "name": data.get("name") or os.path.basename(cwd),
                "project": os.path.basename(cwd.rstrip("/")),
                "status": data.get("status", "idle"),
                "since": (data.get("statusUpdatedAt") or data.get("updatedAt") or 0) / 1000,
            })
        rank = {"busy": 0, "idle": 2}
        sessions.sort(key=lambda x: (rank.get(x["status"], 1), -x["since"]))
        return sessions

    def refresh_claude(self, *_):
        sessions = self.read_claude()
        if sessions != self.claude_sessions:
            self.claude_sessions = sessions
            self.emit()
        return True

    # ------------------------------------------------------------- output

    @staticmethod
    def demo_state():
        """Made-up data for screenshots and for trying the panel out."""
        now = time.time()

        def chat(app, title, text, count, minutes):
            return {"app": app, "title": title, "text": text, "count": count,
                    "ts": now - minutes * 60, "keys": []}

        def mail(app, sender, subject, preview, minutes, new):
            return {"app": app, "summary": sender, "body": subject + "\n" + preview,
                    "ts": now - minutes * 60, "source": "phone", "keys": [], "new": new}

        def issue(ident, title, status, assignee):
            return {"identifier": ident, "title": title, "status": status,
                    "assignee": assignee, "updatedAt": "", "url": ""}

        return {
            "phone": {"name": "Phone", "reachable": True},
            "chats": [
                chat("WhatsApp", "Family", "Mom: Dinner at 8, bring dessert", 3, 4),
                chat("WhatsApp", "Sam Rivera", "Pushed the fix, can you take a look?", 1, 18),
                chat("Telegram", "Climbing crew", "Jo: Saturday morning works for me", 5, 52),
            ],
            "mail": [
                mail("Gmail", "Dana Lee", "Quarterly review", "Slides are in the shared folder, comments welcome before Friday.", 9, True),
                mail("Gmail", "City Library", "Your hold is ready", "Pick it up within seven days at the main branch.", 75, True),
                mail("Outlook", "Build server", "Nightly build passed", "All 412 tests passed in 6m 31s.", 190, False),
            ],
            "mailNew": 2,
            "apps": [{"app": "Calendar", "count": 2}, {"app": "Bank", "count": 1}],
            "paperclip": {
                "ok": True, "blocked": 1, "inReview": 2, "inProgress": 3, "approvals": 1,
                "agentsBusy": 2, "agentsIdle": 4, "agentsPaused": 0, "agentsError": 0,
                "issues": [
                    issue("ACME-41", "Rotate the staging database credentials", "blocked", "Ops"),
                    issue("ACME-38", "Add dark mode to the settings page", "in_review", "Frontend"),
                    issue("ACME-44", "Write the onboarding guide", "in_progress", "Docs"),
                    issue("ACME-36", "Cache avatar thumbnails", "in_review", "Backend"),
                ],
                "updated": now,
            },
            "claude": [
                {"name": "landing-page", "project": "landing-page", "status": "busy", "since": now - 140},
                {"name": "api", "project": "api", "status": "idle", "since": now - 420},
            ],
        }

    def build_state(self):
        cfg = self.config
        if cfg["demo"]:
            return self.demo_state()
        chat_apps = lower_set(cfg["chatApps"])
        phone_mail_apps = lower_set(cfg["phoneMailApps"])
        ignore = lower_set(cfg["ignoreApps"])

        chats = {}
        mail = list(self.desktop_mail)
        apps = {}
        for n in self.phone_items:
            app = n["app"].lower()
            if app in ignore:
                continue
            if app in chat_apps:
                title = n["group"] if n["isGroup"] and n["group"] else n["title"]
                chat = chats.setdefault((n["app"], title), {
                    "app": n["app"], "title": title, "text": "", "count": 0, "ts": 0,
                    "keys": [],
                })
                chat["count"] += 1
                if n["dismissable"]:
                    chat["keys"].append(n["key"])
                if n["ts"] >= chat["ts"]:
                    chat["ts"] = n["ts"]
                    sender = n["title"] if n["isGroup"] and n["title"] != title else ""
                    chat["text"] = (sender + ": " if sender else "") + n["text"]
            elif app in phone_mail_apps:
                mail.append({
                    "app": n["app"], "summary": n["title"], "body": n["text"],
                    "ts": n["ts"], "source": "phone",
                    "keys": [n["key"]] if n["dismissable"] else [],
                })
            else:
                apps[n["app"]] = apps.get(n["app"], 0) + 1

        mail.sort(key=lambda m: m["ts"], reverse=True)
        for m in mail:
            m["new"] = m["ts"] > self.seen_at
            if m["source"] == "desktop":
                m["keys"] = ["mail:%r" % m["ts"]]
        return {
            "phone": self.phone,
            "chats": sorted(chats.values(), key=lambda c: c["ts"], reverse=True),
            "mail": mail[: int(cfg["mailHistory"])],
            "mailNew": sum(1 for m in mail if m["new"]),
            "apps": [{"app": a, "count": c}
                     for a, c in sorted(apps.items(), key=lambda kv: -kv[1])],
            "paperclip": self.paperclip,
            "claude": self.claude_sessions,
        }

    def emit(self):
        out = json.dumps(self.build_state(), ensure_ascii=False)
        if out != self.last_output:
            self.last_output = out
            sys.stdout.write(out + "\n")
            sys.stdout.flush()
        return False

    def refresh(self):
        self.refresh_pending = False
        self.config = load_config()
        self.read_phone()
        self.emit()
        return False

    def schedule_refresh(self, *_):
        # Bursts of KDE Connect signals collapse into one read.
        if not self.refresh_pending:
            self.refresh_pending = True
            GLib.timeout_add(300, self.refresh)

    # ------------------------------------------------------------- commands

    def on_command(self, line):
        cmd = line.strip()
        if cmd == "seen":
            self.seen_at = time.time()
            self.save_mail_state()
            self.emit()
        elif cmd == "refresh":
            self.refresh()
        elif cmd.startswith("dismiss "):
            self.dismiss(cmd.split()[1:])
        return False

    def dismiss(self, keys):
        mails = {k[5:] for k in keys if k.startswith("mail:")}
        if mails:
            self.desktop_mail = [m for m in self.desktop_mail if "%r" % m["ts"] not in mails]
            self.save_mail_state()
        for key in keys:
            if key.startswith("mail:") or "/" not in key:
                continue
            dev, nid = key.split("/", 1)
            try:
                self.bus.call_sync(
                    KDECONNECT, "/modules/kdeconnect/devices/%s/notifications/%s" % (dev, nid),
                    NOTIF_ITEM_IFACE, "dismiss", None, None,
                    Gio.DBusCallFlags.NONE, 3000, None,
                )
            except GLib.Error:
                pass
        self.schedule_refresh()
        self.emit()

    def read_stdin(self):
        for line in sys.stdin:
            GLib.idle_add(self.on_command, line)
        GLib.idle_add(self.loop.quit)

    # ---------------------------------------------------------------- main

    def run(self):
        self.loop = GLib.MainLoop()
        for iface in (NOTIF_IFACE, DEVICE_IFACE, "org.kde.kdeconnect.daemon"):
            self.bus.signal_subscribe(
                None, iface, None, None, None,
                Gio.DBusSignalFlags.NONE, self.schedule_refresh,
            )
        # NameOwnerChanged: KDE Connect restarting.
        self.bus.signal_subscribe(
            "org.freedesktop.DBus", "org.freedesktop.DBus", "NameOwnerChanged",
            "/org/freedesktop/DBus", KDECONNECT, Gio.DBusSignalFlags.NONE,
            self.schedule_refresh,
        )
        GLib.timeout_add_seconds(60, lambda: (self.schedule_refresh(), True)[1])
        # Claude Code rewrites its session files on every status change.
        try:
            self.claude_monitor = Gio.File.new_for_path(CLAUDE_SESSIONS).monitor_directory(
                Gio.FileMonitorFlags.NONE, None)
            self.claude_monitor.connect("changed", self.refresh_claude)
        except GLib.Error:
            pass
        GLib.timeout_add_seconds(30, self.refresh_claude)
        self.claude_sessions = self.read_claude()
        threading.Thread(target=self.watch_desktop_notifications, daemon=True).start()
        threading.Thread(target=self.read_stdin, daemon=True).start()
        threading.Thread(target=self.poll_paperclip, daemon=True).start()
        self.refresh()
        self.loop.run()


if __name__ == "__main__":
    try:
        Feed().run()
    except KeyboardInterrupt:
        pass
