#!/usr/bin/env bash
# Create a named Paperclip board API key for the companion display and save
# it to the token file, using the board session the Paperclip CLI stored in
# ~/.paperclip/auth.json (run `paperclipai auth login` first if needed).
# The key is never printed. Revoke it any time from Paperclip or with
# DELETE /api/board-api-keys/<id>.
#
# Usage: paperclip-create-key <paperclip-url> [days-valid]

set -euo pipefail

base="${1:?usage: paperclip-create-key <paperclip-url> [days-valid]}"
base="${base%/}"
days="${2:-365}"
auth="${PAPERCLIP_AUTH_FILE:-$HOME/.paperclip/auth.json}"
out="$HOME/.config/omarchy/companion-display-paperclip.token"

session=$(jq -r --arg b "$base" '.credentials[$b].token // empty' "$auth")
if [[ -z "$session" ]]; then
  echo "No Paperclip CLI session for $base in $auth. Run: paperclipai auth login" >&2
  exit 1
fi

expires=$(date -u -d "+$days days" +%Y-%m-%dT%H:%M:%SZ)
body=$(jq -n --arg e "$expires" '{name: "companion-display", expiresAt: $e}')

response=$(curl -fsS -X POST "$base/api/board-api-keys" \
  -H "Authorization: Bearer $session" \
  -H "Content-Type: application/json" \
  -d "$body")

token=$(jq -r '.token // empty' <<<"$response")
if [[ -z "$token" ]]; then
  echo "Paperclip did not return a key." >&2
  exit 1
fi

umask 077
printf '%s\n' "$token" > "$out"
echo "Saved key '$(jq -r .name <<<"$response")' (expires $expires) to $out"
