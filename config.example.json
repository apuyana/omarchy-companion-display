{
  "screen": "HDMI-A-1",
  "locale": "en_US",
  "idleSeconds": 300,
  "privacy": false,
  "hideBar": false,
  "chatApps": [
    "WhatsApp",
    "WhatsApp Business",
    "Telegram",
    "Signal",
    "Messages"
  ],
  "phoneMailApps": [
    "Outlook",
    "Gmail",
    "BlueMail"
  ],
  "ignoreApps": [],
  "mailHistory": 30,
  "modules": {
    "clock": true,
    "mail": true,
    "chats": true,
    "apps": true,
    "player": true,
    "claude": true,
    "paperclip": false
  },
  "paperclip": {
    "url": "",
    "companyId": "",
    "name": "",
    "tokenFile": "~/.config/omarchy/companion-display-paperclip.token",
    "interval": 60,
    "maxIssues": 4
  },
  "claude": {
    "doneMinutes": 15,
    "expanded": false
  },
  "launch": {
    "chats": [
      "omarchy-launch-or-focus-webapp",
      "web.whatsapp.com",
      "https://web.whatsapp.com/"
    ],
    "player": [
      "omarchy-launch-or-focus",
      "^spotify$",
      "spotify"
    ],
    "claude": [
      "omarchy-launch-or-focus",
      "^com.anthropic.Claude$",
      "claude-desktop"
    ]
  }
}
